# Colma Analytics Hub — environment template
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match an Authorized redirect URI on the OAuth client exactly.
# Local development:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Production example:
# GOOGLE_REDIRECT_URI=https://analytics.example.com/api/auth/callback/google

# ---------------------------------------------------------------------------
# Session + token encryption
# ---------------------------------------------------------------------------
# Signs and encrypts the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=generate-a-random-32-byte-value

# Encrypts the Google refresh token (AES-256-GCM) before it is written into the
# session cookie. Generate with:
#   openssl rand -base64 32
# Optional: if unset, a key is derived from SESSION_SECRET. Setting it
# explicitly lets you rotate the session secret without invalidating tokens.
TOKEN_ENCRYPTION_KEY=generate-a-second-random-32-byte-value

# Public base URL of the deployment. Required in production so OAuth callbacks
# resolve correctly behind a proxy.
# NEXTAUTH_URL=https://analytics.example.com

# ---------------------------------------------------------------------------
# Optional: database
# ---------------------------------------------------------------------------
# This app is stateless by design — sessions are JWT-based and no Analytics data
# is persisted. DATABASE_URL is unused, and is listed here only as the hook
# point if you later add persistence (saved report presets, scheduled exports).
# DATABASE_URL=postgresql://user:password@localhost:5432/colma_analytics
