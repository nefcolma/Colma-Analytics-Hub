{
  // Cloudflare Workers configuration for the OpenNext build of Colma Analytics Hub.
  // Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colma-analytics-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  // nodejs_compat is required by OpenNext (and by node:crypto used for cache
  // key hashing and token encryption).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // --- Non-secret environment variables -------------------------------------
  // Public config only. Secrets (GOOGLE_CLIENT_SECRET, SESSION_SECRET,
  // TOKEN_ENCRYPTION_KEY) are set with `wrangler secret put`, never here.
  "vars": {
    "GOOGLE_CLIENT_ID": "768631127899-qfcnlv1khau2u0tv48dui4j7ncbbhvcq.apps.googleusercontent.com",
    "NEXTAUTH_URL": "https://colma-analytics-hub.neftali-7ee.workers.dev",
    // Value to register under the Google OAuth client's "Authorized redirect
    // URIs". The app derives the actual redirect_uri from the request host
    // (trustHost); this entry documents the exact URL Google must allow.
    "GOOGLE_REDIRECT_URI": "https://colma-analytics-hub.neftali-7ee.workers.dev/api/auth/callback/google"
  },

  // --- KV: normalized Google Analytics report cache -------------------------
  // Only cached, normalized report responses are stored here. No OAuth tokens,
  // client/session secrets, or auth codes are ever written to KV.
  // `id` is the production namespace (created with
  // `npx wrangler kv namespace create REPORT_CACHE_KV`).
  // `preview_id` is optional — only used by `npm run preview` / `wrangler dev`.
  // Local dev and tests use the in-memory fallback, so it is not required to
  // deploy. To add it, run `npx wrangler kv namespace create REPORT_CACHE_KV
  // --preview` and set "preview_id" to the returned id.
  "kv_namespaces": [
    {
      "binding": "REPORT_CACHE_KV",
      "id": "9ee89c5474ef4338ababbc3a1a5ab9e6"
    }
  ]

  // Secrets (GOOGLE_CLIENT_SECRET, SESSION_SECRET, TOKEN_ENCRYPTION_KEY, ...)
  // are NOT declared here. Set them out of band:
  //   npx wrangler secret put GOOGLE_CLIENT_SECRET
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put TOKEN_ENCRYPTION_KEY
  // and use .dev.vars for local development.
}
